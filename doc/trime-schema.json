{
  "$id": "https://github.com/osfans/trime/blob/develop/doc/trime-schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JSON schema for Trime theme configuration",
  "definitions": {
    "ToolBar.Button.Background": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "default": "rectangle"
        },
        "corner_radius": {
          "type": "number",
          "default": 10
        },
        "bg_normal": {
          "type": "string",
          "default": ""
        },
        "bg_highlight": {
          "type": "string",
          "default": ""
        },
        "vertical_inset": {
          "type": "integer",
          "default": 4
        },
        "horizontal_inset": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "ToolBar.Button.Foreground": {
      "type": "object",
      "properties": {
        "fg_normal": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "fg_highlight": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "font_size": {
          "type": "number",
          "default": 15
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": []
        },
        "padding": {
          "type": "integer",
          "default": 5
        },
        "icon": {
          "type": "string",
          "default": ""
        },
        "option_icons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "ToolBar.Button": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/definitions/ToolBar.Button.Background"
        },
        "foreground": {
          "$ref": "#/definitions/ToolBar.Button.Foreground"
        },
        "action": {
          "type": "string",
          "default": ""
        }
      }
    },
    "StyleNode": {
      "type": "object",
      "description": "A styles: node. Exactly one layer (doc/Theme.md §4): content selects the foreground form; otherwise the background form. The same table also holds panel and item styles (doc/Theme.md §8).",
      "properties": {
        "content": {
          "type": "string",
          "enum": [
            "text",
            "system_icon",
            "asset_icon",
            "nine_patch"
          ]
        },
        "text": {
          "type": "string"
        },
        "text_size": {
          "type": "number"
        },
        "font_face": {
          "type": "string"
        },
        "system_icon": {
          "type": "string"
        },
        "asset_icon": {
          "type": "string"
        },
        "nine_patch": {
          "type": "string"
        },
        "corner_radius": {
          "type": "number"
        },
        "border_width": {
          "type": "number"
        },
        "border_color": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "background_on": {
          "type": "string"
        },
        "background_highlight": {
          "type": "string"
        },
        "text_color": {
          "type": "string"
        },
        "label_size": {
          "type": "number"
        },
        "max_lines": {
          "type": "integer"
        },
        "ellipsize": {
          "type": "string",
          "enum": [
            "start",
            "middle",
            "end",
            "marquee"
          ]
        },
        "icon_size": {
          "type": "number"
        },
        "pin_size": {
          "type": "number"
        },
        "pin_color": {
          "type": "string"
        },
        "pin_inset": {
          "type": "number"
        },
        "padding": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "max_height": {
          "type": "integer"
        },
        "side_margin": {
          "type": "number"
        },
        "item_spacing": {
          "type": "number"
        },
        "action_button_size": {
          "type": "integer"
        },
        "divider": {
          "type": "integer",
          "default": 0,
          "description": "Hairline between a panel's list items in dp; 0 draws none."
        },
        "divider_color": {
          "type": "string",
          "default": "",
          "description": "Divider token; empty falls back to key_border_color."
        },
        "min_height": {
          "type": "integer",
          "default": 0,
          "description": "Item minimum height in dp; 0 = content."
        },
        "height": {
          "type": "integer",
          "default": 0,
          "description": "Item height in dp (panels: 0 = content, -1 = fill)."
        },
        "width": {
          "type": "integer",
          "default": 0,
          "description": "Panel width: 0 = content, -1 = fill."
        },
        "icon_color": {
          "type": "string",
          "default": "",
          "description": "Item icon colour token."
        }
      },
      "additionalProperties": true
    },
    "TextKey": {
      "type": "object",
      "properties": {
        "click": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "long_click": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "label": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "static",
                    "schemaName",
                    "schemaId",
                    "enterLabel",
                    "custom"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Key label (doc/Keyboard.md §2.2): a string, or {source: ...}."
        },
        "width": {
          "type": "number",
          "default": 0,
          "description": "Percentage of the row; -1 fills what the row leaves over; 0 uses the keyboard default width."
        },
        "swipe_left": {
          "type": "string"
        },
        "swipe_right": {
          "type": "string"
        },
        "swipe_up": {
          "type": "string"
        },
        "swipe_down": {
          "type": "string"
        },
        "composing": {
          "type": "string"
        },
        "send_bindings": {
          "type": "boolean"
        },
        "key": {
          "type": "string",
          "default": "",
          "description": "Identity of the key (doc/Keyboard.md §2.1): a preset_keys name or a built-in character key name; an explicit click overrides it."
        },
        "style": {
          "type": "string",
          "default": "",
          "description": "Name in styles: (doc/Theme.md §4)."
        },
        "row_break": {
          "type": "boolean",
          "default": false,
          "description": "Inside a flow container: start a new row before this entry."
        },
        "height": {
          "type": "number",
          "default": 0,
          "description": "Row height hint in dp; a line's intrinsic height (doc/Keyboard.md §2.6)."
        }
      }
    },
    "LayoutRow": {
      "type": "object",
      "properties": {
        "row": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LayoutNode"
          }
        },
        "width": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent row's width in percent; -1 fills what the row leaves over; 0 uses the keyboard default width."
        },
        "height": {
          "type": "number",
          "default": 0,
          "description": "Height inside a vertical parent, in dp; -1 fills what the stack leaves over; 0 uses the intrinsic height."
        },
        "height_percent": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent stack's height in percent; wins over height when positive."
        },
        "row_break": {
          "type": "boolean",
          "default": false,
          "description": "Inside a flow container: start a new line before this entry."
        }
      },
      "required": [
        "row"
      ],
      "additionalProperties": false,
      "description": "One physical line: children are placed left to right and never wrap (doc/Keyboard.md §2.6)."
    },
    "LayoutFlow": {
      "type": "object",
      "properties": {
        "flow": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LayoutNode"
          }
        },
        "width": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent row's width in percent; -1 fills what the row leaves over; 0 uses the keyboard default width."
        },
        "height": {
          "type": "number",
          "default": 0,
          "description": "Height inside a vertical parent, in dp; -1 fills what the stack leaves over; 0 uses the intrinsic height."
        },
        "height_percent": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent stack's height in percent; wins over height when positive."
        },
        "row_break": {
          "type": "boolean",
          "default": false,
          "description": "Inside a flow container: start a new line before this entry."
        }
      },
      "required": [
        "flow"
      ],
      "additionalProperties": false,
      "description": "Placed by width, wrapping when a child does not fit (doc/Keyboard.md §2.6)."
    },
    "LayoutColumn": {
      "type": "object",
      "properties": {
        "column": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LayoutNode"
          }
        },
        "width": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent row's width in percent; -1 fills what the row leaves over; 0 uses the keyboard default width."
        },
        "height": {
          "type": "number",
          "default": 0,
          "description": "Height inside a vertical parent, in dp; -1 fills what the stack leaves over; 0 uses the intrinsic height."
        },
        "height_percent": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent stack's height in percent; wins over height when positive."
        },
        "row_break": {
          "type": "boolean",
          "default": false,
          "description": "Inside a flow container: start a new line before this entry."
        }
      },
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "description": "Children stacked top to bottom, one line each (doc/Keyboard.md §2.6)."
    },
    "LayoutCollection": {
      "type": "object",
      "properties": {
        "collection": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "default": "",
                  "description": "A liquid_keyboard category id; its keys are the cells (doc/Keyboard.md §2.6)."
                },
                "scroll": {
                  "enum": [
                    "vertical",
                    "horizontal"
                  ],
                  "default": "vertical",
                  "description": "Scroll axis of the collection."
                },
                "cell_height": {
                  "type": "number",
                  "default": 0,
                  "description": "Cell height in dp; 0 uses the keyboard's default row height."
                },
                "cell_width": {
                  "type": "number",
                  "default": 0,
                  "description": "Cell width in dp; 0 uses a square cell."
                },
                "columns": {
                  "type": "integer",
                  "default": 0,
                  "description": "Cells per line while scrolling vertically; 0 fits them to the width."
                },
                "width": {
                  "type": "number",
                  "default": 0,
                  "description": "Share of the parent row's width in percent; -1 fills what the row leaves over; 0 uses the keyboard default width."
                },
                "height": {
                  "type": "number",
                  "default": 0,
                  "description": "Height inside a vertical parent, in dp; -1 fills what the stack leaves over; 0 uses the intrinsic height."
                },
                "height_percent": {
                  "type": "number",
                  "default": 0,
                  "description": "Share of the parent stack's height in percent; wins over height when positive."
                },
                "row_break": {
                  "type": "boolean",
                  "default": false,
                  "description": "Inside a flow container: start a new line before this entry."
                }
              },
              "additionalProperties": false,
              "description": "A scrollable symbol grid embedded in the keyboard (doc/Keyboard.md §2.6)."
            }
          ],
          "description": "The collection: a category id, or the category id with its cell metrics."
        },
        "width": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent row's width in percent; -1 fills what the row leaves over; 0 uses the keyboard default width."
        },
        "height": {
          "type": "number",
          "default": 0,
          "description": "Height inside a vertical parent, in dp; -1 fills what the stack leaves over; 0 uses the intrinsic height."
        },
        "height_percent": {
          "type": "number",
          "default": 0,
          "description": "Share of the parent stack's height in percent; wins over height when positive."
        },
        "row_break": {
          "type": "boolean",
          "default": false,
          "description": "Inside a flow container: start a new line before this entry."
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false,
      "description": "A scrollable set of symbols read from liquid_keyboard (doc/Keyboard.md §2.6)."
    },
    "LayoutNode": {
      "oneOf": [
        {
          "$ref": "#/definitions/TextKey"
        },
        {
          "$ref": "#/definitions/LayoutRow"
        },
        {
          "$ref": "#/definitions/LayoutFlow"
        },
        {
          "$ref": "#/definitions/LayoutColumn"
        },
        {
          "$ref": "#/definitions/LayoutCollection"
        }
      ],
      "description": "One node of a keyboard layout tree: a key (leaf) or a container (doc/Keyboard.md §2.6)."
    }
  },
  "type": "object",
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "\\d+(\\.\\d+)*",
      "description": "config version"
    },
    "name": {
      "type": "string",
      "description": "方案名稱"
    },
    "author": {
      "type": "string",
      "description": "作者資訊"
    },
    "style": {
      "type": "object",
      "properties": {
        "auto_caps": {
          "enum": [
            true,
            false,
            "ascii"
          ],
          "default": false,
          "description": "自动句首大写"
        },
        "candidate_font": {
          "type": "string",
          "description": "候選字型"
        },
        "candidate_padding": {
          "type": "integer",
          "description": "候選項內邊距"
        },
        "candidate_spacing": {
          "type": "number",
          "description": "候選間距"
        },
        "candidate_text_size": {
          "type": "integer",
          "description": "候選字號"
        },
        "candidate_view_height": {
          "type": "integer",
          "description": "候選區高度"
        },
        "comment_font": {
          "type": "string",
          "description": "編碼提示字型"
        },
        "comment_height": {
          "type": "integer",
          "description": "編碼提示區高度"
        },
        "comment_on_top": {
          "type": "boolean",
          "description": "編碼提示在上方或右側"
        },
        "comment_text_size": {
          "type": "integer",
          "description": "編碼提示字號"
        },
        "hanb_font": {
          "type": "string",
          "description": "擴充字型"
        },
        "horizontal_gap": {
          "type": "integer",
          "description": "鍵水平間距"
        },
        "keyboard_padding": {
          "type": "integer",
          "description": "竖屏模式下，屏幕左右两侧与键盘的距离（曲面屏减少误触）"
        },
        "keyboard_padding_left": {
          "type": "integer",
          "description": "竖屏屏模式下，左手键盘布局，屏幕左侧与键盘的距离"
        },
        "keyboard_padding_right": {
          "type": "integer",
          "description": "竖屏屏模式下，左手键盘布局，屏幕右侧与键盘的距离"
        },
        "keyboard_padding_bottom": {
          "type": "integer",
          "description": "竖屏模式下，屏幕下边缘与键盘的距离（避免误触发全面屏手势）"
        },
        "keyboard_padding_land": {
          "type": "integer",
          "description": "横屏模式下，屏幕左右两侧与键盘的距离（避免横屏按键过度拉伸变形）"
        },
        "keyboard_padding_land_bottom": {
          "type": "integer",
          "description": "横屏模式下，屏幕下侧与键盘的距离"
        },
        "key_font": {
          "type": "string",
          "description": "鍵盤字型"
        },
        "key_height": {
          "type": "integer",
          "description": "鍵高"
        },
        "key_text_size": {
          "type": "integer",
          "description": "鍵字號"
        },
        "key_width": {
          "type": "number",
          "description": "鍵寬，佔螢幕寬的百分比"
        },
        "keyboards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "鍵盤配置"
        },
        "label_text_size": {
          "type": "integer",
          "description": "標籤字號"
        },
        "label_font": {
          "type": "string",
          "description": "編標籤字型"
        },
        "latin_font": {
          "type": "string",
          "description": "西文字型"
        },
        "keyboard_height": {
          "type": "integer",
          "description": "锁定键盘高度，避免切换时键盘高度变化而造成闪烁"
        },
        "keyboard_height_land": {
          "type": "integer",
          "description": "锁定横屏下键盘高度，避免切换时键盘高度变化而造成闪烁"
        },
        "preview_font": {
          "type": "string",
          "description": "按鍵提示字型"
        },
        "preview_height": {
          "type": "integer",
          "description": "按鍵提示高度"
        },
        "preview_offset": {
          "type": "integer",
          "default": "-12",
          "description": "按鍵提示縱向偏移"
        },
        "preview_text_size": {
          "type": "integer",
          "description": "按鍵提示字號"
        },
        "proximity_correction": {
          "type": "boolean",
          "description": "按鍵糾錯"
        },
        "reset_ascii_mode_on_focus_change": {
          "type": "boolean",
          "description": "焦点变更弹起输入法软键盘时，重置 ascii_mode"
        },
        "round_corner": {
          "type": "number",
          "description": "按鍵圓角半徑"
        },
        "shadow_radius": {
          "type": "number",
          "description": "按鍵陰影半徑"
        },
        "symbol_font": {
          "type": "string",
          "description": "符號字型"
        },
        "symbol_text_size": {
          "type": "integer",
          "description": "編碼字型"
        },
        "vertical_correction": {
          "type": "number",
          "default": "-10",
          "description": "触摸位置校正（竖直方向）。为了提升打字手感，可将按键的实际触摸位置相对其显示位置上下偏移一点点"
        },
        "vertical_gap": {
          "type": "number",
          "description": "鍵盤行距"
        },
        "background_folder": {
          "type": "string",
          "description": "背景图保存在background目录下的哪个子目录"
        },
        "enter_label_mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "是否使用App提供的ActionLabel内容作为Enter键的文本（由于多数App没有适配ActionLable，实际影响不大）。0不使用，1只使用actionlabel，2优先使用，3当其他方式没有获得label时才读取actionlabel"
        },
        "enter_labels": {
          "type": "object",
          "description": "定义Enter键的文本",
          "properties": {
            "go": {
              "type": "string",
              "default": "前往"
            },
            "done": {
              "type": "string",
              "default": "完成"
            },
            "next": {
              "type": "string",
              "default": "下个"
            },
            "pre": {
              "type": "string",
              "default": "上个"
            },
            "search": {
              "type": "string",
              "default": "搜索"
            },
            "send": {
              "type": "string",
              "default": "发送"
            },
            "default": {
              "type": "string",
              "default": "Enter"
            }
          }
        }
      }
    },
    "preedit": {
      "type": "object",
      "properties": {
        "horizontal_padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "default": 8
        },
        "top_start_radius": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 48,
          "default": 0.0
        },
        "top_end_radius": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 48,
          "default": 0.0
        },
        "alpha": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "foreground": {
          "type": "object",
          "properties": {
            "font_size": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 64,
              "default": 16
            }
          }
        }
      }
    },
    "window": {
      "type": "object",
      "properties": {
        "insets": {
          "type": "object",
          "properties": {
            "vertical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "default": 0
            },
            "horizontal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "default": 0
            }
          }
        },
        "item_padding": {
          "type": "object",
          "properties": {
            "vertical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "default": 0
            },
            "horizontal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "default": 0
            }
          }
        },
        "min_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 640,
          "default": 0
        },
        "corner_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 48,
          "default": 0
        },
        "border": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24,
          "default": 0
        },
        "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 0
        },
        "alpha": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "foreground": {
          "type": "object",
          "properties": {
