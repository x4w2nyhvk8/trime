    "preset_keys": {
      "type": "object",
      "description": "Key ids follow doc/Keyboard.md: <role>Button in lowerCamelCase for everything inside the IME, and the 15 whitelisted Android intent names in UPPER_SNAKE_CASE.",
      "propertyNames": {
        "anyOf": [
          {
            "pattern": "^[a-z][a-zA-Z0-9]*Button$"
          },
          {
            "enum": [
              "BRIGHTNESS_DOWN",
              "BRIGHTNESS_UP",
              "VOLUME_DOWN",
              "VOLUME_UP",
              "VOLUME_MUTE",
              "CALCULATOR",
              "CALENDAR",
              "CONTACTS",
              "ENVELOPE",
              "EXPLORER",
              "MUSIC",
              "POWER",
              "SEARCH",
              "SLEEP",
              "VOICE_ASSIST"
            ]
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          },
          "preview": {
            "type": "string"
