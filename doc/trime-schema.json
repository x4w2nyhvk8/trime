            "type": "string"
          },
          "select": {
            "type": "string"
          },
          "toggle": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "shift_lock": {
            "type": "string"
          },
          "functional": {
            "type": "boolean"
          },
          "repeatable": {
            "type": "boolean"
          },
          "sticky": {
            "type": "boolean"
          },
          "slide_cursor": {
            "type": "boolean"
          },
          "slide_delete": {
            "type": "boolean"
          },
          "states": {
